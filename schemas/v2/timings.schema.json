{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shortsmaker.local/schemas/v2/timings.schema.json",
  "title": "ShortsMaker phrase timings v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lang", "audio", "source", "status", "phrases"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "range": {
      "type": "array",
      "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }],
      "minItems": 2,
      "maxItems": 2
    }
  },
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "lang": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "durationMs", "sampleRate", "channels"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "durationMs": { "type": "integer", "minimum": 1 },
        "sampleRate": { "const": 24000 },
        "channels": { "const": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spokenSha256", "phrasingSha256", "aligner"],
      "properties": {
        "spokenSha256": { "$ref": "#/$defs/sha256" },
        "phrasingSha256": { "$ref": "#/$defs/sha256" },
        "aligner": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["engine", "endpoint", "algorithmVersion", "overallLoss"],
              "properties": {
                "engine": { "const": "elevenlabs-forced-alignment" },
                "endpoint": { "const": "/v1/forced-alignment" },
                "algorithmVersion": { "type": "integer", "minimum": 1 },
                "overallLoss": { "type": "number", "minimum": 0 }
              }
            }
          ]
        }
      }
    },
    "status": { "enum": ["ok", "needs_alignment_review"] },
    "phrases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sentenceId", "display", "spoken", "displayRange", "spokenRange",
                     "startMs", "endMs", "maxWordLoss", "timingSource", "review", "issues"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}-[0-9a-f]{8}(-[1-9][0-9]*)?$" },
          "sentenceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
          "display": { "type": "string", "minLength": 1 },
          "spoken": { "type": "string", "minLength": 1 },
          "displayRange": { "$ref": "#/$defs/range" },
          "spokenRange": { "$ref": "#/$defs/range" },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 0 },
          "maxWordLoss": { "type": ["number", "null"], "minimum": 0 },
          "timingSource": { "enum": ["aligner", "manual"] },
          "review": { "enum": ["auto", "flagged", "reviewed"] },
          "issues": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["high-loss", "long-gap", "repeat-risk", "non-monotonic", "overlap", "too-short", "out-of-range"] }
          }
        }
      }
    }
  }
}

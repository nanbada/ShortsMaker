{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shortsmaker.local/schemas/v2/script.schema.json",
  "title": "ShortsMaker script v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "lang", "title", "voice", "sentences"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "jobId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,47}$" },
    "lang": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "title": { "type": "string", "minLength": 1, "maxGraphemes": 100 },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "voiceId", "settings", "seed"],
      "properties": {
        "provider": { "const": "elevenlabs" },
        "model": { "enum": ["eleven_v4"] },
        "voiceId": { "type": "string", "pattern": "^[A-Za-z0-9]{1,64}$" },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stability", "similarity"],
          "properties": {
            "stability": { "type": "number", "minimum": 0, "maximum": 1 },
            "similarity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "sentences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
          "display": { "type": "string", "minLength": 1, "maxGraphemes": 200, "pattern": "^[^\\[\\]]+$" },
          "spoken": { "type": "string", "minLength": 1, "maxGraphemes": 300, "pattern": "^[^\\[\\]]+$" },
          "tag": { "type": "string", "minLength": 1, "maxGraphemes": 60, "pattern": "^[^\\[\\]]+$" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://\\S+$" }
        }
      }
    }
  }
}

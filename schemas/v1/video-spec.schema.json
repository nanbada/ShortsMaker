{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShortsMaker VideoSpec v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "language",
    "format",
    "brand",
    "safeArea",
    "assets",
    "narration",
    "captions",
    "scenes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "ko-KR"
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1920
        },
        "fps": {
          "const": 30
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2700
        }
      },
      "required": [
        "width",
        "height",
        "fps",
        "durationFrames"
      ]
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontAssetId": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "fontAssetId",
        "primary",
        "accent",
        "background",
        "text"
      ]
    },
    "safeArea": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "integer",
          "minimum": 0
        },
        "right": {
          "type": "integer",
          "minimum": 0
        },
        "bottom": {
          "type": "integer",
          "minimum": 0
        },
        "left": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ]
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "enum": [
            "manual",
            "azure",
            "google",
            "elevenlabs",
            "local"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "scriptPath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[A-Za-z0-9_./-]+$"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "offsetFrame": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "assetId",
        "provider",
        "model",
        "voice",
        "scriptPath",
        "durationMs",
        "offsetFrame"
      ]
    },
    "captions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caption"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "text"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 1
              },
              "motion": {
                "enum": [
                  "none",
                  "fade",
                  "slide",
                  "slowZoom"
                ]
              },
              "transitionOut": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "cut",
                      "crossfade"
                    ]
                  },
                  "durationFrames": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "type",
                  "durationFrames"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "id",
              "startFrame",
              "durationFrames",
              "motion",
              "transitionOut",
              "title",
              "body"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "image"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 1
              },
              "motion": {
                "enum": [
                  "none",
                  "fade",
                  "slide",
                  "slowZoom"
                ]
              },
              "transitionOut": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "cut",
                      "crossfade"
                    ]
                  },
                  "durationFrames": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "type",
                  "durationFrames"
                ]
              },
              "assetId": {
                "type": "string",
                "minLength": 1
              },
              "fit": {
                "enum": [
                  "contain",
                  "cover"
                ]
              },
              "focus": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y"
                ]
              }
            },
            "required": [
              "type",
              "id",
              "startFrame",
              "durationFrames",
              "motion",
              "transitionOut",
              "assetId",
              "fit",
              "focus"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "browser"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 1
              },
              "motion": {
                "enum": [
                  "none",
                  "fade",
                  "slide",
                  "slowZoom"
                ]
              },
              "transitionOut": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "cut",
                      "crossfade"
                    ]
                  },
                  "durationFrames": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "type",
                  "durationFrames"
                ]
              },
              "assetId": {
                "type": "string",
                "minLength": 1
              },
              "fit": {
                "enum": [
                  "contain",
                  "cover"
                ]
              },
              "highlight": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ]
              }
            },
            "required": [
              "type",
              "id",
              "startFrame",
              "durationFrames",
              "motion",
              "transitionOut",
              "assetId",
              "fit",
              "highlight"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "comparison"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 1
              },
              "motion": {
                "enum": [
                  "none",
                  "fade",
                  "slide",
                  "slowZoom"
                ]
              },
              "transitionOut": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "cut",
                      "crossfade"
                    ]
                  },
                  "durationFrames": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "type",
                  "durationFrames"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "left": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              },
              "right": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              }
            },
            "required": [
              "type",
              "id",
              "startFrame",
              "durationFrames",
              "motion",
              "transitionOut",
              "title",
              "left",
              "right"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "cta"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 1
              },
              "motion": {
                "enum": [
                  "none",
                  "fade",
                  "slide",
                  "slowZoom"
                ]
              },
              "transitionOut": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "cut",
                      "crossfade"
                    ]
                  },
                  "durationFrames": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "type",
                  "durationFrames"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "id",
              "startFrame",
              "durationFrames",
              "motion",
              "transitionOut",
              "title",
              "body"
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "image",
            "audio",
            "font"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[A-Za-z0-9_./-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "rights": {
          "enum": [
            "owned",
            "licensed",
            "public-domain",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "sha256",
        "source",
        "rights"
      ]
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "granularity": {
          "enum": [
            "phrase",
            "word"
          ]
        },
        "timingSource": {
          "enum": [
            "native",
            "aligned",
            "manual"
          ]
        }
      },
      "required": [
        "text",
        "startMs",
        "endMs",
        "granularity",
        "timingSource"
      ]
    }
  }
}
